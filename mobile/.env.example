# Same project as the website. These two values are public and bundled in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Public cart/checkout API origin. Use the deployed backend by default.
EXPO_PUBLIC_API_BASE_URL=https://betadrips.netlify.app
# Explicit local override when starting Metro from mobile/:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8888 npx expo start --dev-client --localhost --port 8081 --max-workers 1
# Local mode requires Netlify dev and adb reverse tcp:8888 tcp:8888.
# Restart Metro and fully reload the app when switching the API origin.
